# Leave unset on Vercel to use the same-origin /api/verify-receipt function.
# Set this only when GitHub Pages calls a separately hosted checkout API.
NEXT_PUBLIC_RECEIPT_VERIFY_URL=

# Contact form email delivery.
RESEND_API_KEY=
CONTACT_EMAIL=venus.alarbeed.support@gmail.com

# Server-only secrets for Vercel. Never prefix these with NEXT_PUBLIC_.
BOOK_TOKEN_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
BOOK_EN_BLOB_PATH=books/conscious-diplomacy-en.pdf
BOOK_AR_BLOB_PATH=books/conscious-diplomacy-ar.pdf

# Added automatically when a private Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=

RECEIPT_EXPECTED_ACCOUNT_SUFFIX=4742
RECEIPT_EXPECTED_RECIPIENTS=venus alarbeed|venus wajih alarbeed|فينوس العربيد|فينوس وجيه العربيد
RECEIPT_ALLOWED_AMOUNTS=2.99,3.00,3.10
MAX_ATTEMPTS_PER_HOUR=6
BOOK_LINK_TTL_SECONDS=1800
BOOK_ACCESS_TTL_DAYS=365
